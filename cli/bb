#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
#  🔵 BLUEBEAKEND CLI (`bb` / `bluebeakend`) — v1.0.0
#  Interactive management menu + direct subcommands:
#    bb                 → Launch interactive 12-option menu
#    bb status          → Show service health, metrics & system stats
#    bb apikeys         → Manage project API keys
#    bb users           → Manage users
#    bb backup          → Create / list / restore / schedule backups
#    bb logs [service]  → View container or API logs
#    bb docs            → Print SDK/curl examples or open Swagger UI
#    bb version         → Print CLI & server version
# ════════════════════════════════════════════════════════════════════
set -euo pipefail

BB_VERSION="1.0.0"

# Locate installation directory (/opt/bluebeakend in prod, or repo root in dev)
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
REPO_GUESS="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

if [[ -n "${BB_INSTALL_DIR:-}" ]]; then
  INSTALL_DIR="$BB_INSTALL_DIR"
elif [[ -f "/opt/bluebeakend/docker-compose.yml" ]]; then
  INSTALL_DIR="/opt/bluebeakend"
else
  INSTALL_DIR="$REPO_GUESS"
fi

ENV_FILE="${INSTALL_DIR}/.env"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

BB_DOMAIN="${BB_DOMAIN:-localhost}"
BB_PROTOCOL="${BB_PROTOCOL:-http}"
API_URL="${BB_API_URL:-}"
if [[ -z "$API_URL" ]]; then
  if curl -fsSL --max-time 2 "http://127.0.0.1:8080/healthz" >/dev/null 2>&1; then
    API_URL="http://127.0.0.1:8080"
  elif curl -fsSL --max-time 2 "http://127.0.0.1/healthz" >/dev/null 2>&1; then
    API_URL="http://127.0.0.1"
  else
    API_URL="${BB_PROTOCOL}://${BB_DOMAIN}"
  fi
fi

ADMIN_EMAIL="${ADMIN_EMAIL:-admin@bluebeakend.local}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:-}"
GITHUB_REPO="${BB_GITHUB_REPO:-siddhantpashte123-hub/beakend}"

# ── ANSI Palette ───────────────────────────────────────────────────
BLUE='\033[38;5;33m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

ADMIN_TOKEN=""

pause_prompt() {
  echo ""
  read -r -p "  Press Enter to return to menu… " _ || true
}

progress_bar() {
  local pct="$1" label="$2"
  local filled=$(( pct * 26 / 100 ))
  local empty=$(( 26 - filled ))
  local bar=""
  for ((i=0; i<filled; i++)); do bar+="█"; done
  for ((i=0; i<empty; i++)); do bar+="░"; done
  echo -e "  ${BLUE}${bar}${NC} ${BOLD}${pct}%${NC}  ${label}"
}

has_docker_stack() {
  command -v docker >/dev/null 2>&1 && [[ -f "${INSTALL_DIR}/docker-compose.yml" ]] && \
    docker compose -f "${INSTALL_DIR}/docker-compose.yml" ps --quiet 2>/dev/null | grep -q .
}

ensure_admin_token() {
  if [[ -n "$ADMIN_TOKEN" ]]; then
    return 0
  fi
  if [[ -z "$ADMIN_PASSWORD" ]]; then
    read -r -s -p "  Admin password for ${ADMIN_EMAIL}: " ADMIN_PASSWORD
    echo ""
  fi
  local resp
  resp="$(curl -fsSL -X POST "${API_URL}/api/v1/admin/login" \
    -H "Content-Type: application/json" \
    -d "$(jq -nc --arg e "$ADMIN_EMAIL" --arg p "$ADMIN_PASSWORD" '{email:$e,password:$p}')" 2>/dev/null || true)"
  ADMIN_TOKEN="$(echo "$resp" | jq -r '.accessToken // empty' 2>/dev/null || true)"
  if [[ -z "$ADMIN_TOKEN" ]]; then
    echo -e "  ${RED}❌ Could not authenticate against ${API_URL}/api/v1/admin/login${NC}"
    return 1
  fi
  return 0
}

api_admin() {
  local method="$1" path="$2" body="${3:-}"
  ensure_admin_token || return 1
  if [[ -n "$body" ]]; then
    curl -fsSL -X "$method" "${API_URL}${path}" \
      -H "Authorization: Bearer ${ADMIN_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$body"
  else
    curl -fsSL -X "$method" "${API_URL}${path}" \
      -H "Authorization: Bearer ${ADMIN_TOKEN}"
  fi
}

update_env_var() {
  local key="$1" val="$2"
  touch "$ENV_FILE"
  if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$ENV_FILE"
  else
    echo "${key}=${val}" >> "$ENV_FILE"
  fi
}

format_bytes() {
  local b="${1:-0}"
  if (( b >= 1073741824 )); then
    awk -v b="$b" 'BEGIN {printf "%.1f GB", b/1073741824}'
  elif (( b >= 1048576 )); then
    awk -v b="$b" 'BEGIN {printf "%.0f MB", b/1048576}'
  elif (( b >= 1024 )); then
    awk -v b="$b" 'BEGIN {printf "%.0f KB", b/1024}'
  else
    printf "%d B" "$b"
  fi
}

format_uptime() {
  local s="${1:-0}"
  local d=$(( s / 86400 ))
  local h=$(( (s % 86400) / 3600 ))
  local m=$(( (s % 3600) / 60 ))
  printf "%dd %dh %dm" "$d" "$h" "$m"
}

