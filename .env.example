# ─────────────────────────────────────────────────────────────
# BlueBeakend — environment configuration
# Auto-generated by install.sh with secure random secrets.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
BB_VERSION=1.0.0
BB_ENV=production

# Domain / public URL (defaults to VPS IP if not set)
BB_DOMAIN=localhost
BB_PROTOCOL=http

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=bluebeakend
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bluebeakend
DATABASE_URL=postgres://bluebeakend:CHANGE_ME@postgres:5432/bluebeakend

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ── MinIO (S3-compatible object storage) ─────────────────────
MINIO_ROOT_USER=bluebeakend
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=bluebeakend
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=bluebeakend
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=bluebeakend

# ── Auth / JWT ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
JWT_ISSUER=bluebeakend
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ── Admin bootstrap (first super-admin user) ─────────────────
ADMIN_EMAIL=admin@bluebeakend.local
ADMIN_PASSWORD=CHANGE_ME

# ── First project API key (printed at install) ───────────────
# API_KEY=bb_live_xxxxxxxx

# ── SMTP (optional — password reset / verify emails) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BlueBeakend <no-reply@bluebeakend.local>"

# ── Limits ───────────────────────────────────────────────────
RATE_LIMIT_RPM=600
MAX_UPLOAD_MB=50
ENABLE_SIGNUPS=true

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=*
